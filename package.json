{
  "name": "mafry-api",
  "version": "2.0.0",
  "description": "API REST y panel administrativo para Industria de Alimentos MAFRY (vendedores de ruta)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint src tests scripts",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --forceExit --coverage",
    "audit": "npm audit --audit-level=high --omit=dev"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mafry",
    "vendedores",
    "ruta",
    "express",
    "postgresql"
  ],
  "author": "Equipo MAFRY - UMG Ingeniería en Sistemas",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "reporters": [
      "default",
      "jest-junit"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "junit.xml"
  }
}
